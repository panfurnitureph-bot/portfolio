  "faqs": {
    "title": "FAQs",
    "items": [
      {
        "q": "How much do you charge for delivery?",
        "a": "Delivery is quoted per city at checkout. San Pedro and nearby provinces are delivered by our own trucks; farther provinces go through partner couriers."
      },
      {
        "q": "How long does a made-to-order bed take?",
        "a": "Most frames are finished within 3–5 weeks. We send photos from the workshop on Messenger as it progresses."
      },
      {
        "q": "Can I change the size or fabric?",
        "a": "Yes. Every bed and sofa is built to order, so you can pick any size and any fabric from the swatch library, or send us your own."
      },
      {
        "q": "How do I pay?",
        "a": "A 30% downpayment via QR Ph or card confirms the order; the balance is settled before delivery."
      },
      {
        "q": "Do you assemble?",
        "a": "Our delivery team assembles and positions the piece in the room you choose."
      },
      {
        "q": "What is covered by the warranty?",
        "a": "The frame is covered for one year against structural defects. Fabric wear is not covered."
      }
    ]
  },
